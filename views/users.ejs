<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Utilisateurs - Port de plaisance Russell</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <!-- Menu de navigation -->
  <header class="topbar">
    <a class="logo" href="/dashboard"> Port Russell</a>
    <nav>
      <a href="/dashboard">Tableau de bord</a>
      <a href="/dashboard/catways">Catways</a>
      <a href="/dashboard/reservations">Réservations</a>
      <a href="/dashboard/users">Utilisateurs</a>
      <a href="/api-docs">Documentation</a>
      <a href="/logout" data-logout>Déconnexion</a>
    </nav>
  </header>

  <main class="container">

    <!-- Liste des utilisateurs -->
    <section class="card">
      <h1>Utilisateurs</h1>
      <table>
        <thead>
          <tr>
            <th>Nom</th>
            <th>Email</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach((user) => { %>
            <tr>
              <td><%= user.username %></td>
              <td><%= user.email %></td>
              <td><a href="/dashboard/users/<%= encodeURIComponent(user.email) %>">Voir le détail</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <!-- Création d'un utilisateur -->
    <section class="card">
      <h2>Créer un utilisateur</h2>
      <form data-api="/users" data-method="POST">
        <label for="username">Nom d'utilisateur</label>
        <input type="text" id="username" name="username" required>

        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>

        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" minlength="6" required>

        <button type="submit">Créer</button>
        <p class="message"></p>
      </form>
    </section>

  </main>

  <script src="/javascripts/script.js"></script>
</body>
</html>