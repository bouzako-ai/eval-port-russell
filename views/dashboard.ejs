<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tableau de bord - Port de plaisance Russell</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <!-- Menu de navigation -->
  <header class="topbar">
    <a class="logo" href="/dashboard"> Port Russell</a>
    <nav>
      <a href="/dashboard">Tableau de bord</a>
      <a href="/dashboard/catways">Catways</a>
      <a href="/dashboard/reservations">Réservations</a>
      <a href="/dashboard/users">Utilisateurs</a>
      <a href="/api-docs">Documentation</a>
      <a href="/logout" data-logout>Déconnexion</a>
    </nav>
  </header>

  <main class="container">

    <!-- Utilisateur connecté et date du jour -->
    <section class="card">
      <h1>Tableau de bord</h1>
      <p>Connecté en tant que <strong><%= user.username %></strong> (<%= user.email %>)</p>
      <p>
        Nous sommes le
        <%= today.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
      </p>
    </section>

    <!-- Réservations en cours -->
    <section class="card">
      <h2>Réservations en cours</h2>
      <% if (reservations.length === 0) { %>
        <p>Aucune réservation en cours.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Catway</th>
              <th>Client</th>
              <th>Bateau</th>
              <th>Début</th>
              <th>Fin</th>
            </tr>
          </thead>
          <tbody>
            <% reservations.forEach((reservation) => { %>
              <tr>
                <td><%= reservation.catwayNumber %></td>
                <td><%= reservation.clientName %></td>
                <td><%= reservation.boatName %></td>
                <td><%= reservation.startDate.toLocaleDateString('fr-FR') %></td>
                <td><%= reservation.endDate.toLocaleDateString('fr-FR') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>

  </main>

  <script src="/javascripts/script.js"></script>
</body>
</html>