<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Réservations | Port de plaisance Russell</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <!-- Menu de navigation -->
  <header class="topbar">
    <a class="logo" href="/dashboard"> Port Russell</a>
    <nav>
      <a href="/dashboard">Tableau de bord</a>
      <a href="/dashboard/catways">Catways</a>
      <a href="/dashboard/reservations">Réservations</a>
      <a href="/dashboard/users">Utilisateurs</a>
      <a href="/api-docs">Documentation</a>
      <a href="/logout" data-logout>Déconnexion</a>
    </nav>
  </header>

  <main class="container">

    <!-- Liste de toutes les réservations -->
    <section class="card">
      <h1>Réservations</h1>
      <p>Créer une réservation à partir de la page <a href="/dashboard/catways">Catways</a>.</p>

      <% if (reservations.length === 0) { %>
        <p>Aucune réservation.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Catway</th>
              <th>Client</th>
              <th>Bateau</th>
              <th>Début</th>
              <th>Fin</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% reservations.forEach((reservation) => { %>
              <tr>
                <td><%= reservation.catwayNumber %></td>
                <td><%= reservation.clientName %></td>
                <td><%= reservation.boatName %></td>
                <td><%= reservation.startDate.toLocaleDateString('fr-FR') %></td>
                <td><%= reservation.endDate.toLocaleDateString('fr-FR') %></td>
                <td><a href="/dashboard/reservations/<%= reservation._id %>">Voir le détail</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>

  </main>

  <script src="/javascripts/script.js"></script>
</body>
</html>