<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Catway n°<%= catway.catwayNumber %> | Port de plaisance Russell
    </title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <!-- Menu de navigation -->
    <header class="topbar">
      <a class="logo" href="/dashboard">⚓ Port Russell</a>
      <nav>
        <a href="/dashboard">Tableau de bord</a>
        <a href="/dashboard/catways">Catways</a>
        <a href="/dashboard/reservations">Réservations</a>
        <a href="/dashboard/users">Utilisateurs</a>
        <a href="/api-docs">Documentation</a>
        <a href="/logout" data-logout>Déconnexion</a>
      </nav>
    </header>

    <main class="container">
      <!-- Détails du catway -->
      <section class="card">
        <h1>Catway n°<%= catway.catwayNumber %></h1>
        <p><strong>Type :</strong> <%= catway.catwayType %></p>
        <p><strong>État :</strong> <%= catway.catwayState %></p>
        <p><a href="/dashboard/catways">← Retour à la liste des catways</a></p>
      </section>

      <!-- Modification de l'état (le numéro et le type ne sont pas modifiables) -->
      <section class="card">
        <h2>Modifier l'état</h2>
        <form data-api="/catways/<%= catway.catwayNumber %>" data-method="PUT">
          <label for="catwayState">Nouvel état</label>
          <input
            type="text"
            id="catwayState"
            name="catwayState"
            value="<%= catway.catwayState %>"
            required
          />
          <button type="submit">Enregistrer</button>
          <p class="message"></p>
        </form>
      </section>

      <!-- Suppression du catway -->
      <section class="card">
        <h2>Supprimer ce catway</h2>
        <form
          data-api="/catways/<%= catway.catwayNumber %>"
          data-method="DELETE"
          data-confirm="Supprimer ce catway et toutes ses réservations ?"
          data-redirect="/dashboard/catways"
        >
          <button type="submit" class="danger">Supprimer</button>
          <p class="message"></p>
        </form>
      </section>
    </main>

    <script src="/javascripts/script.js"></script>
  </body>
</html>
